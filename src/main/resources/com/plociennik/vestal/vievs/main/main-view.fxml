<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>

<VBox
        alignment="CENTER"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.plociennik.vestal.controller.MainController"
        stylesheets="@main.css"
>
    <HBox fx:id="logoutButtonArea" alignment="CENTER_RIGHT">
        <Button fx:id="changeRepositoriesButton"> Change repos </Button>
        <Button fx:id="logoutButton"> Logout </Button>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS">
        <fx:include source="../landing/landing-view.fxml" fx:id="landingPage" stylesheets="@../landing/landing.css"/>
        <fx:include source="../githublogin/github-login-view.fxml" fx:id="githubLogin" stylesheets="@../githublogin/github-login.css"/>
        <fx:include source="../encryptionkey/encryption-key-view.fxml" fx:id="encryptionKey" stylesheets="@../encryptionkey/encryption-key.css"/>
        <fx:include source="../setuprepositories/setup-repositories-view.fxml" fx:id="setupActions" stylesheets="@../setuprepositories/setup-repositories.css"/>
        <fx:include source="../gitactions/git-actions-view.fxml" fx:id="gitActions" stylesheets="@../gitactions/git-actions.css"/>
    </StackPane>

    <!--    // todo: make status bar component/view-->

    <fx:include source="../dummytest/dummy-test-view.fxml" fx:id="dummyTest" stylesheets="@../dummytest/dummy-test.css"/>

</VBox>