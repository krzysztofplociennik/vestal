<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.text.Text?>

<VBox
        spacing="10.0"
        alignment="CENTER_LEFT"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:id="encryptionKey"
        fx:controller="com.plociennik.vestal.controller.EncryptionKeyController"
        stylesheets="@../css/encryptionkey.css"
>

    <VBox fx:id="encryptionKeyArea" alignment="CENTER">
        <Text text="Paste your encryption key here."/>
        <PasswordField fx:id="encryptionKeyField"/>
        <Button fx:id="encryptionKeyButton" text="Save the encryption key"/>
    </VBox>

</VBox>