<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<VBox
        alignment="CENTER"
        fx:id="setupRepositoriesArea"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.plociennik.vestal.controller.SetupRepositoriesController"
        stylesheets="@setup-repositories.css"
>

    <HBox fx:id="statusLabelArea" alignment="CENTER">
        <Text fx:id="statusLabelText" text="Pick both local and remote repository"/>
    </HBox>

    <HBox alignment="CENTER" fx:id="setupRepositoriesSubArea">

        <VBox alignment="CENTER" fx:id="localRepoArea" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <VBox fx:id="card" alignment="CENTER">
                <ImageView>
                    <Image url="@../../assets/images/folder-3-64-white.png"/>
                </ImageView>
                <Text> local </Text>
                <Text fx:id="localRepoTitleText"/>
                <Button fx:id="addChangeLocalRepoButton"/>
            </VBox>
        </VBox>

        <VBox alignment="CENTER" fx:id="remoteRepoArea" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <VBox fx:id="card" alignment="CENTER">
                <ImageView>
                    <Image url="@../../assets/images/geography-64-white.png"/>
                </ImageView>
                <Text> remote </Text>
                <Text fx:id="remoteRepoTitleText"/>
                <Button fx:id="addChangeRemoteRepoButton" text="add"/>
            </VBox>
        </VBox>

    </HBox>

</VBox>
