<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<VBox
        spacing="10.0"
        alignment="CENTER"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:id="encryptionKey"
        fx:controller="com.plociennik.vestal.controller.EncryptionKeyController"
        stylesheets="@encryptionkey.css"
>

    <VBox alignment="CENTER">
        <padding>
            <Insets top="20" bottom="50"/>
        </padding>
        <Text> You have successfully logged in </Text>
    </VBox>

    <VBox spacing="20" fx:id="encryptionKeyArea" alignment="CENTER">
        <Text text="Paste or write down your encryption key below"/>
        <PasswordField maxWidth="300" fx:id="encryptionKeyField"/>
        <Button fx:id="encryptionKeyButton" text="Save"/>
    </VBox>

</VBox>