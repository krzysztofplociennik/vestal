<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>

<HBox
        spacing="10.0"
        alignment="CENTER_LEFT"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:id="dummyTest"
        fx:controller="com.plociennik.vestal.controller.DummyTestController"
        stylesheets="@../css/dummytest.css"
>

    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>

    <!-- 1. Login -->
    <Button fx:id="loginButton"
            text="Login"
            onAction="#handleLogin"
            maxWidth="1.0E38"
            HBox.hgrow="ALWAYS">
        <tooltip>
            <Tooltip text="Authenticate via GitHub device code"/>
        </tooltip>
    </Button>

    <!-- 2. Repos -->
    <Button fx:id="reposButton"
            text="Repos"
            onAction="#handleRepos"
            maxWidth="1.0E38"
            HBox.hgrow="ALWAYS">
        <tooltip>
            <Tooltip text="Configure local directory and remote repository"/>
        </tooltip>
    </Button>

    <!-- 3. Actions -->
    <Button fx:id="actionsButton"
            text="Actions"
            onAction="#handleActions"
            maxWidth="1.0E38"
            HBox.hgrow="ALWAYS">
        <tooltip>
            <Tooltip text="Execute status check, pull/decrypt, or push/encrypt"/>
        </tooltip>
    </Button>

</HBox>