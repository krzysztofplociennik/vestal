<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>

<HBox
        fx:id="loginArea"
        alignment="CENTER"
        fx:controller="com.plociennik.vestal.controller.GithubLoginController"
        xmlns:fx="http://javafx.com/fxml">

    <Label fx:id="loginStatus" text="not logged in"/>
    <StackPane>
        <Button fx:id="loginButton" text="login" onAction="#onLoginButtonClick"/>
        <Button fx:id="logoutButton" text="logout" onAction="#onLogoutButtonClick" visible="false"/>
    </StackPane>
</HBox>