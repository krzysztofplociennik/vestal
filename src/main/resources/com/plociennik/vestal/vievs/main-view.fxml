<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.StackPane?>
<VBox
        alignment="TOP_CENTER"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.plociennik.vestal.controller.MainController"
        stylesheets="@../css/main.css"
>

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <StackPane>
        <fx:include source="githubLogin-view.fxml" fx:id="githubLogin" stylesheets="@../css/githubLogin.css"/>
        <fx:include source="setupActions-view.fxml" fx:id="setupActions" stylesheets="@../css/setupActions.css"/>
        <fx:include source="gitActions-view.fxml" fx:id="gitActions" stylesheets="@../css/gitActions.css"/>
    </StackPane>

    <!--    // todo: make status bar component/view-->

    <fx:include source="dummytest-view.fxml" fx:id="dummyTest" stylesheets="@../css/dummytest.css"/>

</VBox>
