    <fx:include source="githubLogin-view.fxml" fx:id="githubLogin" stylesheets="@../css/githubLogin.css"/>
    <fx:include source="setupActions-view.fxml" fx:id="setupActionsVBox" stylesheets="@../css/setupActions.css"/>

</VBox>
